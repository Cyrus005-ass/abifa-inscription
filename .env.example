# Variables à ajouter dans Vercel > Settings > Environment Variables.
# Remplace les valeurs d'exemple par celles de ton projet. Ne publie jamais les secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Espace organisateur (URL : /gestion-abifa-2026-secret)
ADMIN_PASSWORD=replace_with_a_strong_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters
